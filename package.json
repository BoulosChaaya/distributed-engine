{
  "name": "distributed-engine",
  "version": "1.0.1",
  "description": "Distributed task execution engine with API, workers, and dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r run start",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "lint": "eslint .",
    "verify": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  }
}
