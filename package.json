{
  "name": "distributed-engine",
  "version": "0.1.0",
  "description": "Distributed task execution engine with API, workers, and dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm -r run start",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "lint": "pnpm -r run lint",
    "verify": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  }
}
